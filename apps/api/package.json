{
  "name": "@openrucpe/api",
  "private": true,
  "type": "module",
  "portless": "api.openrucpe",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:portless": "portless",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "data:check": "bun src/cli/check.ts",
    "data:build": "bun src/cli/import.ts",
    "data:fixture": "bun test/fixtures/build-fixture.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "hono": "^4.13.3",
    "iconv-lite": "^0.7.3",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/unzipper": "^0.10.11",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2"
  }
}
